{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Branchcraft",
  "version": "0.1.0",
  "identifier": "io.github.username.Branchcraft",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Branchcraft",
        "width": 1120,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Branchcraft contributors",
    "copyright": "Copyright © 2026 Branchcraft contributors",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A fast, focused desktop Git client",
    "longDescription": "Branchcraft is a fast, focused desktop Git client for Linux and Windows, built with Rust and Tauri.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "rpm": {
        "release": "1",
        "files": {
          "../packaging/io.github.username.Branchcraft.metainfo.xml": "/usr/share/metainfo/io.github.username.Branchcraft.metainfo.xml"
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}

